{% comment %}
  Atribe storefront attribution app embed.
  Enable this from Theme settings -> App embeds.
{% endcomment %}

<script>
  window.atribeThemeContext = {
    themeId: "nocturne-editorial",
    countryCode: "{{ localization.country.iso_code | default: '' }}",
    languageTag: "{{ request.locale.iso_code | replace: '_', '-' | default: '' }}"
  };
</script>

{% schema %}
{
  "name": "Atribe Attribution",
  "target": "head",
  "javascript": "atribe-app-embed.js",
  "settings": []
}
{% endschema %}
