PORT=3001
HOST=localhost
NODE_ENV=development
ATRIBE_BASE_URL=https://atribe.io
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_orders,read_script_tags,write_script_tags
SHOPIFY_APP_URL=https://your-public-app-url.example.com
SHOPIFY_CALLBACK_URL=https://your-public-app-url.example.com/auth/callback
SHOPIFY_API_VERSION=2026-04
SQLITE_DB_PATH=./shopify-app.db
DEFAULT_COMMISSION_RATE=0.10
PLATFORM_FEE_RATE=0.00
LOG_LEVEL=debug
