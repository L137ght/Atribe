{
  "manifest_version": 3,
  "name": "Atribe Extension",
  "version": "1.0.0",
  "description": "Atribe routes supported product pages through the backend attribution engine.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://*.amazon.*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
